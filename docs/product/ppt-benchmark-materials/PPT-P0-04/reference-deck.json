  "assets": [],
  "claims": [
    {
      "id": "effective",
      "text": "2023 命令设定 2023-12-01 生效；待决程序仅在公正且可行范围内适用。",
      "source": "https://www.uscourts.gov/sites/default/files/2023_congressional_package_april_24_2023_0.pdf",
      "locator": "第 194 页"
    },
    {
      "id": "old",
      "text": "2022 历史汇编 Rule 702 开头列出四项条件；仅供与后版文字比较。",
      "source": "https://www.uscourts.gov/sites/default/files/federal_rules_of_evidence_december_1_2022_0.pdf",
      "locator": "第 29 页"
    },
    {
      "id": "new-opening",
      "text": "2024 历史汇编开头增加由提出方向法院作更可能为真的展示。",
      "source": "https://www.govinfo.gov/content/pkg/CPRT-118HPRT57151/pdf/CPRT-118HPRT57151.pdf",
      "locator": "第 30 页"
    },
    {
      "id": "new-d",
      "text": "2024 历史汇编 (d) 使用专家意见反映可靠应用的表述。",
      "source": "https://www.govinfo.gov/content/pkg/CPRT-118HPRT57151/pdf/CPRT-118HPRT57151.pdf",
      "locator": "第 31 页"
    },
    {
      "id": "standard",
      "text": "官方 Note 说明 Rule 104(a) 门槛适用于规则中的可靠性要求。",
      "source": "https://www.uscourts.gov/sites/default/files/2023_congressional_package_april_24_2023_0.pdf",
      "locator": "第 210 页"
    },
    {
      "id": "weight",
      "text": "官方 Note 保留部分专家证言异议属于重量而非可采性的情形。",
      "source": "https://www.uscourts.gov/sites/default/files/2023_congressional_package_april_24_2023_0.pdf",
      "locator": "第 211 页"
    },
    {
      "id": "scope",
      "text": "官方 Note 强调专家意见不得超出其基础与方法可靠支持的范围。",
      "source": "https://www.uscourts.gov/sites/default/files/2023_congressional_package_april_24_2023_0.pdf",
      "locator": "第 212 页"
    },
    {
      "id": "certainty",
      "text": "官方 Note 对实体法要求特定确定程度的证言保留例外。",
      "source": "https://www.uscourts.gov/sites/default/files/2023_congressional_package_april_24_2023_0.pdf",
      "locator": "第 213 页"
    },
    {
      "id": "procedure",
      "text": "官方 Note 表明修订不新增特定程序。",
      "source": "https://www.uscourts.gov/sites/default/files/2023_congressional_package_april_24_2023_0.pdf",
      "locator": "第 213 页"
    },
    {
      "id": "rule-1101",
      "text": "联邦证据规则的适用范围须按 Rule 1101 的法院和例外条款判断。",
      "source": "https://www.govinfo.gov/content/pkg/CPRT-118HPRT57151/pdf/CPRT-118HPRT57151.pdf",
      "locator": "第 43 页"
    }
  ],
