{
  "name": "@wiswork/shell",
  "productName": "WisWork",
  "version": "0.6.12",
  "license": "Apache-2.0",
  "homepage": "https://github.com/AtomInnoLab/WisWork",
  "private": true,
  "description": "Unified WisWork shell hosting Docs, Sheets, Slides, PDF, Markdown, and LaTeX",
  "main": "out/main/index.js",
  "desktopName": "wiswork.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@wiswork/agent-core": "*",
    "@wiswork/agent-runtime": "*",
    "@wiswork/ai-provider": "*",
    "@wiswork/ai-search": "*",
    "@wiswork/auth": "*",
    "@wiswork/codex-bridge": "*",
    "@wiswork/docs": "*",
    "@wiswork/docx-engine": "*",
    "@wiswork/electron-utils": "*",
    "@wiswork/i18n": "*",
    "@wiswork/latex": "*",
    "@wiswork/latex-compiler": "*",
    "@wiswork/latex-project": "*",
    "@wiswork/office-bridge": "*",
    "@wiswork/markdown": "*",
    "@wiswork/pdf-viewer": "*",
    "@wiswork/pptx-engine": "*",
    "@wiswork/pptx-render": "*",
    "@wiswork/sheets": "*",
    "@wiswork/slides": "*",
    "@wiswork/ui": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "AtomInnoLab"
}
