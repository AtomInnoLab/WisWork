{
  "name": "@wiswork/pptx-engine",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "pptx parsing (Slide element tree with byte anchors + inheritance resolution), OOXML fragment generation, element-patch save",
  "exports": {
    ".": "./src/index.ts",
    "./table-grid": "./src/table-grid.ts",
    "./background-promote": "./src/background-promote.ts",
    "./presentation": "./src/presentation.ts",
    "./presentation-plan": "./src/presentation-plan.ts",
    "./presentation-compiler": "./src/presentation-compiler.ts",
    "./presentation-content-check": "./src/presentation-content-check.ts",
    "./presentation-claim-evidence": "./src/presentation-claim-evidence.ts",
    "./presentation-page-reviews": "./src/presentation-page-reviews.ts",
    "./presentation-claim-review": "./src/presentation-claim-review.ts",
    "./presentation-delivery-report": "./src/presentation-delivery-report.ts",
    "./presentation-calculation": "./src/presentation-calculation.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1",
    "@wiswork/project-store": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
